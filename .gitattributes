# Force LF for shell scripts so Linux shebangs never see bash\r
* text=auto

*.sh     text eol=lf
*.awk    text eol=lf
*.conf   text eol=lf
install.sh text eol=lf
traffic-monitor.sh text eol=lf

*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
.gitignore text eol=lf

*.png    binary
*.jpg    binary
*.gif    binary
